# Shared helpers for every .envrc, linked to ~/.config/direnv/direnvrc.

# use gcloud [name]
#
# Points CLOUDSDK_CONFIG at ~/.config/gcloud-repos/<name>, so the project gets
# its own gcloud account, project and Application Default Credentials instead of
# the global ones. Go's credential lookup, which Terraform uses, ignores
# CLOUDSDK_CONFIG, so GOOGLE_APPLICATION_CREDENTIALS is pointed at the same
# directory's credentials file too. <name> defaults to the directory holding the
# .envrc. A missing directory is still exported, with an error, so gcloud and Go
# programs fail as not logged in instead of acting as the global identity.
# Create it once with
#   mkdir -p ~/.config/gcloud-repos/<name>
#   export CLOUDSDK_CONFIG=~/.config/gcloud-repos/<name>
#   gcloud auth login
#   env -u GOOGLE_APPLICATION_CREDENTIALS gcloud auth application-default login
#   gcloud config set project <project>
# Run the application-default login that way inside the project too: with the
# variable set, gcloud stops to suggest unsetting it, which is wrong here (it
# writes the same file through CLOUDSDK_CONFIG), and fails with no terminal.
use_gcloud() {
  local cfg="$HOME/.config/gcloud-repos/${1:-$(basename "$PWD")}"
  export CLOUDSDK_CONFIG=$cfg
  export GOOGLE_APPLICATION_CREDENTIALS=$cfg/application_default_credentials.json
  if [[ ! -d $cfg ]]; then
    log_error "use gcloud: $cfg does not exist; create it and log in to gcloud with CLOUDSDK_CONFIG set to it (steps in ~/.config/direnv/direnvrc)"
    return 1
  fi
}
