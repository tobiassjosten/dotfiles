{
  "permissions": {
    "allow": [
      "Bash(awk:*)",
      "Bash(cat:*)",
      "Bash(dig:*)",
      "Bash(echo:*)",
      "Bash(file:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(rg:*)",
      "Bash(tar:*)",
      "Bash(tree:*)",
      "Bash(wc:*)",
      "Bash(xargs ls:*)",
      "Bash(xxd)",
      "Bash(go build:*)",
      "Bash(go doc:*)",
      "Bash(go fmt:*)",
      "Bash(go get:*)",
      "Bash(go help:*)",
      "Bash(go install:*)",
      "Bash(go mod:*)",
      "Bash(go run:*)",
      "Bash(go test:*)",
      "Bash(go version:*)",
      "Bash(go vet:*)",
      "Bash(gci:*)",
      "Bash(gofmt:*)",
      "Bash(goimports:*)",
      "Bash(golangci-lint:*)",
      "Bash(git add:*)",
      "Bash(git check-ignore:*)",
      "Bash(git checkout:*)",
      "Bash(git commit:*)",
      "Bash(git diff:*)",
      "Bash(git fetch:*)",
      "Bash(git log:*)",
      "Bash(git mv:*)",
      "Bash(git push)",
      "Bash(git reset:*)",
      "Bash(git revert:*)",
      "Bash(git stash:*)",
      "Bash(git status:*)",
      "Bash(gh release:*)",
      "Bash(gh run:*)",
      "Bash(gh variable:*)",
      "Bash(terraform output:*)",
      "Bash(terraform validate:*)",
      "Bash(terraform state list:*)",
      "Bash(terraform fmt:*)",
      "Bash(terraform providers:*)",
      "Bash(terraform import:*)",
      "Bash(fly:*)",
      "Bash(sqlfluff:*)",
      "WebFetch(domain:developers.cloudflare.com)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:docs.cloud.google.com)",
      "WebFetch(domain:docs.mixpanel.com)",
      "WebFetch(domain:docs.tic.io)",
      "WebFetch(domain:fly.io)",
      "WebFetch(domain:golang.org)",
      "WebFetch(domain:pkg.go.dev)",
      "WebFetch(domain:registry.terraform.io)",
      "WebSearch"
    ],
    "deny": [],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "command -v rtk >/dev/null 2>&1 && rtk hook claude || exit 0"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$TMUX_PANE\" ] && printf '\\a' > \"$(tmux display-message -t \"$TMUX_PANE\" -p '#{pane_tty}')\" || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/notify-stop.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true
  },
  "alwaysThinkingEnabled": true,
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipWorkflowUsageWarning": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
